NODE_ENV=development
PORT=3000
CORS_ALLOWED_ORIGINS=http://localhost:3000

# Prime model (OpenAI-compatible / Ollama-style endpoint)
PRIME_MODEL_ENABLED=true
PRIME_MODEL_URL=http://127.0.0.1:11434/api/chat
PRIME_MODEL_NAME=qwen2.5-coder:7b
PRIME_MODEL_TIMEOUT_MS=60000
PRIME_MODEL_RETRIES=1
PRIME_MODEL_FAILURE_COOLDOWN_MS=10000
PRIME_MODEL_DISCOVERY_TIMEOUT_MS=2500
PRIME_MODEL_FALLBACKS=qwen3:8b,qwen2.5:7b,llama3.1:8b,gemma3:4b,qwen2.5-coder:7b
PRIME_MODEL_PROVIDER=ollama
PRIME_MODEL_API_KEY=
PRIME_MODEL_TEMPERATURE=0.2
PRIME_MODEL_MAX_TOKENS=4096
PRIME_MODEL_CONTEXT_SIZE=8192

# Live web search. Keep keys server-side only.
BRAVE_SEARCH_API_KEY=
SEARCH_COUNTRY=IN
SEARCH_LANGUAGE=en
SEARCH_BROWSER_FALLBACK=true
SEARCH_BROWSER_PATH=
SEARCH_FETCH_PAGES=true
SEARCH_PAGE_FETCH_TOP_RESULTS=5
SEARCH_PAGE_FETCH_TIMEOUT_MS=7000
SEARCH_PAGE_MAX_BYTES=1500000
SEARCH_PAGE_TEXT_MAX_LENGTH=1600
PRIME_EXPOSE_SEARCH_METADATA=false

# Self-hosted Prime image engine (local or separate private service)
PRIME_IMAGE_SERVICE_URL=http://127.0.0.1:7861
PRIME_IMAGE_ENGINE_TOKEN=
IMAGE_PROVIDER_ORDER=local,stability,openai,replicate
PRIME_IMAGE_SERVICE_TIMEOUT_MS=1200000

# Optional remote image fallbacks
STABILITY_API_KEY=
OPENAI_API_KEY=
OPENAI_IMAGE_MODEL=gpt-image-1
REPLICATE_API_TOKEN=
REPLICATE_IMAGE_MODEL=

# Vision / image understanding
PRIME_VISION_ENABLED=true
PRIME_VISION_MODEL=qwen3-vl:8b
PRIME_VISION_MODEL_URL=
PRIME_VISION_TIMEOUT_MS=90000
PRIME_VISION_RETRIES=1
PRIME_VISION_MAX_IMAGE_BYTES=6291456
PRIME_VISION_TEMPERATURE=0.2
PRIME_VISION_MAX_TOKENS=4096
PRIME_VISION_CONTEXT_SIZE=8192
PRIME_VISION_KEEP_ALIVE=10m

# ===== Prime Intelligence Stack =====
# Optional self-hosted SearXNG metasearch endpoint, e.g. http://127.0.0.1:8080
SEARXNG_URL=
# Optional local BGE embedding/reranker service endpoints
PRIME_EMBEDDING_URL=
PRIME_RERANKER_URL=
PRIME_ENABLE_OLLAMA_EMBEDDINGS=false
PRIME_EMBEDDING_MODEL=bge-m3
# Optional structured document intelligence service
PRIME_DOCLING_URL=
PRIME_DOCLING_CLI=false
PRIME_DOCLING_COMMAND=docling
# Optional local speech/voice service (faster-whisper + emotion2vec + OpenVoice)
PRIME_VOICE_SERVICE_URL=
# Model fallback order
PRIME_MODEL_FALLBACKS=qwen3:8b,qwen2.5:7b,llama3.1:8b,gemma3:4b,qwen2.5-coder:7b
PRIME_VISION_MODEL_FALLBACKS=qwen3-vl:8b,gemma3:4b,llava:7b
QDRANT_URL=
QDRANT_COLLECTION=prime_memory
PRIME_MODEL_ROUTER_ENABLED=true
PRIME_AGENT_MAX_STEPS=8
PRIME_VOICE_SERVICE_URL=
